# Rollup configuration. Copy to .env and fill for live mode.
# SYNC_MODE is fixture, live, or tracker. fixture reads bundled sample data; live calls the APIs below; tracker reads the local tracker.
ROLLUP_SYNC_MODE=fixture
ROLLUP_DB_PATH=rollup.db

# Jira (live mode). Read-only service account. Boards = the 4 board keys.
ROLLUP_JIRA_BASE_URL=
ROLLUP_JIRA_EMAIL=
ROLLUP_JIRA_TOKEN=
ROLLUP_JIRA_BOARDS=PAY,AUD

# GitHub (live mode). Fine-grained PAT, read-only: Contents/PRs/Metadata read.
ROLLUP_GITHUB_TOKEN=
ROLLUP_GITHUB_ORG=
# Repos we ingest; repo->epic mapping lives in the DB (settings page), not here.
ROLLUP_GITHUB_REPOS=payments-core,audit-trail
# Local tracker base URL for tracker mode. Read only.
ROLLUP_TRACKER_URL=http://127.0.0.1:4321

# Matching thresholds are P1; recorded now so config shape is stable.
ROLLUP_T_HIGH=0.82
ROLLUP_T_LOW=0.70
